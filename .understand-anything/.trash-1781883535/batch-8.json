      "name": "models.py",
      "filePath": "src/snapshot/snapshot_consumer/models.py",
      "summary": "Read-only frozen dataclass models mirroring the Layer-2 Snapshot contract (SCHEMA-001), including per-series values, quality guards, summaries, and the top-level Snapshot with deterministic id recomputation.",
      "tags": ["data-model", "type-definition", "serialization", "validation"],
      "complexity": "complex",
      "languageNotes": "Stdlib-only frozen dataclasses with from_dict factory classmethods that fail-closed via a shared _require helper; snapshot id is recomputed deterministically with hashlib.sha256 over sorted series lines."
    },
