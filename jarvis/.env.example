# Copy to .env and adjust. Used by docker-compose and (for the host populate step) the exporter.
# OFFLINE / LOCAL (default):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=elnino_dev
NEO4J_DATABASE=neo4j

# NEO4J AURA (managed cloud) — swap to these later; exporter, API, and UI are unchanged:
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<aura-generated-password>
# NEO4J_DATABASE=neo4j
