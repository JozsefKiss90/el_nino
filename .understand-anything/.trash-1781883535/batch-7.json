      "name": "decision_engine.py",
      "filePath": "src/supervisor/decision_engine/decision_engine.py",
      "summary": "Implements the deterministic DecisionEngine (MOD-002) that scores candidate upgrades against an EvaluationScorecard under treasury and institutional-memory constraints and emits a DecisionPacket.",
      "tags": ["decision-engine", "service", "supervisor", "deterministic", "api-handler"],
      "complexity": "moderate",
      "languageNotes": "Deterministic ranking via stable sort key (-score, upgrade_id) ensures identical inputs yield identical packets."
    },
    {
      "id": "file:src/supervisor/decision_engine/models.py",
      "type": "file",
      "name": "models.py",
      "filePath": "src/supervisor/decision_engine/models.py",
      "summary": "Frozen-dataclass value objects for the Decision Engine, realizing the EvaluationScorecard input contract (SCHEMA-005) and DecisionPacket/RankedOption output contract (SCHEMA-004) plus internal treasury and config types.",
      "tags": ["data-model", "type-definition", "decision-engine", "validation", "supervisor"],
      "complexity": "moderate",
      "languageNotes": "Dependency-free frozen dataclasses enforce invariants via __post_init__ guards (e.g., blocked options must carry a reason)."
    },
    {
      "id": "file:src/supervisor/decision_engine/scoring.py",
