  "nodes": [
    {
      "id": "file:ops/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "ops/__init__.py",
      "summary": "Package marker for the Operations Control Plane (ADR-013); documents the ops console's separation from src/ (zero-runtime-deps) and exposes the package version.",
      "tags": ["entry-point", "package-init", "ops", "documentation"],
      "complexity": "simple",
      "languageNotes": "Python package __init__ that defines __all__ and __version__ only; the trading engine never imports it, preserving ADR-003 zero-runtime-deps."
    },
    {
      "id": "file:ops/actions.py",
      "type": "file",
      "name": "actions.py",
      "filePath": "ops/actions.py",
      "summary": "Safe (non-gated) operator actions for the ops console: run the chain now, rerun calibration readiness, and resync Neo4j, each persisting an audit entry via a finish helper.",
      "tags": ["service", "ops", "audit", "action-handler"],
      "complexity": "moderate",
      "languageNotes": "Each action is wrapped so it never raises to the UI; _finish redacts secrets and writes the audit entry before returning an ActionResult."
    },
    {
      "id": "file:ops/app.py",
      "type": "file",
      "name": "app.py",
      "filePath": "ops/app.py",
      "summary": "Textual TUI for the Operations Control Plane: renders the multi-tab dashboard over ops.core and dispatches safe and confirmation-gated operator actions in worker threads.",
      "tags": ["entry-point", "component", "ops", "tui", "ui"],
      "complexity": "complex",
      "languageNotes": "Built on Textual App/Screen; long-running actions run via call_from_thread workers, gated actions push a ConfirmModal screen before executing."
    },
    {
      "id": "file:ops/audit.py",
      "type": "file",
      "name": "audit.py",
      "filePath": "ops/audit.py",
      "summary": "Append-only JSONL audit log for the ops console: builds, writes, appends, and tail-reads AuditEntry records of every operator action.",
      "tags": ["service", "audit", "serialization", "ops"],
      "complexity": "moderate",
      "languageNotes": "Writes ASCII-only JSON lines (ensure_ascii) so the log survives Windows codepage quirks; read tolerates and skips malformed lines."
    },
    {
      "id": "file:ops/core.py",
      "type": "file",
      "name": "core.py",
      "filePath": "ops/core.py",
      "summary": "Headless governed read-model for the ops console: assembles the full dashboard (ledger, portfolio, operational, decision preview, gates, calibration, plugs, processes, policy, events) from src/ governed functions without reimplementing safety logic.",
      "tags": ["data-model", "service", "ops", "read-model", "dashboard"],
      "complexity": "complex",
      "languageNotes": "Fifteen frozen dataclass view models plus pure builder functions; reuses src/ load_ledger/load_portfolio/run_sequence rather than duplicating gate or paper-only logic."
    },
    {
      "id": "file:ops/gated.py",
      "type": "file",
      "name": "gated.py",
      "filePath": "ops/gated.py",
      "summary": "Confirmation-gated, side-effecting operator actions: run the chain against the Alpaca paper adapter, register/unregister the daily scheduled task, and commit a calibration bump, all audited.",
      "tags": ["service", "ops", "audit", "action-handler", "gated"],
      "complexity": "moderate",
      "languageNotes": "Mirrors actions.py but for state-changing operations; precondition_line surfaces a human-readable gate check before the UI confirms execution."
    },
    {
      "id": "file:ops/proc.py",
      "type": "file",
      "name": "proc.py",
      "filePath": "ops/proc.py",
      "summary": "Subprocess execution helpers for the ops console: a default command runner returning a ProcResult plus tail and secret-redaction utilities used before persisting subprocess output.",
      "tags": ["utility", "ops", "subprocess", "security"],
      "complexity": "simple",
      "languageNotes": "redact scrubs known env-var secret values out of captured output so credentials never reach the audit log."
    },
