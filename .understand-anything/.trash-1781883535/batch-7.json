      "filePath": "src/supervisor/decision_engine/scoring.py",
      "summary": "Pure deterministic scoring functions that rate an upgrade option by the severity of the office's weakness in the targeted dimension, weighted by expected improvement and cost efficiency.",
      "tags": ["scoring", "utility", "decision-engine", "deterministic", "supervisor"],
      "complexity": "simple",
      "languageNotes": "Dimension-to-weakness function dispatch via a module-level dict registry (WEAKNESS_DIMENSIONS)."
    },
