{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "mcpvault": {
      "command": "npx",
      "args": [
        "@bitbonsai/mcpvault@latest",
        "C:\\Code\\layer_3_wiki"
      ],
      "env": {}
    },
    "smart-connections": {
      "command": "npx",
      "args": [
        "-y",
        "@yejianye/smart-connections-mcp"
      ],
      "env": {
        "OBSIDIAN_VAULT": "C:\\Code\\layer_3_wiki"
      }
    },
    "neo4j": {
        "type": "stdio",
        "command": "python",
        "args": [
          "-m",
          "neo4j_mcp_server"
        ],
        "env": {
          "NEO4J_URI": "bolt://localhost:7687",
          "NEO4J_USERNAME": "neo4j",
          "NEO4J_PASSWORD": "password",
          "NEO4J_DATABASE": "neo4j",
          "NEO4J_READ_ONLY": "true",
          "NEO4J_TELEMETRY": "false",
          "NEO4J_TRANSPORT_MODE": "stdio",
          "NEO4J_LOG_LEVEL": "info",
          "NEO4J_LOG_FORMAT": "text",
          "NEO4J_SCHEMA_SAMPLE_SIZE": "100",
          "NEO4J_GDS_ENABLED": "false"
        }
      },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-postgres-server"
      ],
      "env": {
        "PG_HOST": "localhost",
        "PG_PORT": "5432",
        "PG_USER": "postgres",
        "PG_PASSWORD": "password",
        "PG_DATABASE": "layer_3_wiki"
      }
    }
  }
}