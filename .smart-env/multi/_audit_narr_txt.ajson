9,0.02129954,0.00381596,0.0128544,0.01915747,0.1830681,0.01509994,0.00542337,0.01000232,-0.00046148,0.05209941,0.05100931,-0.01135573,0.05141301,0.01231332,0.1061155,-0.02423253,0.03270345,0.03420613,0.06026206,0.02315984,0.02599598,-0.08412202,-0.00712132,0.02553843,-0.00694834,0.04476191,0.02742788,-0.06629511,-0.0255049,-0.02709788,0.03497704,0.01557013,-0.00162115,-0.08826675,0.00305067,0.01450914,0.0145198,0.06369714,-0.04258138,-0.01558743,-0.02763565,-0.01985675,0.01806566,0.03629432,0.0685698,0.05183201,-0.01561411],"last_embed":{"tokens":443,"hash":"1rst32s"}}},"last_read":{"hash":"1rst32s","at":1782068242875},"class_name":"SmartSource","last_import":{"mtime":1782068225219,"size":51579,"at":1782068239241,"hash":"1rst32s"},"blocks":{"#####2.1 Authentication & environment + 2.10 Paper→live cutover (key=auth)":[3,4],"#####2.1 Authentication & environment + 2.10 Paper→live cutover (key=auth)#{1}":[4,4],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit":[5,28],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#{1}":[7,8],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Strengths (evidence-cited)":[9,14],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Strengths (evidence-cited)#{1}":[10,14],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Gaps (both governed, both low-severity at this epoch)":[15,18],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Gaps (both governed, both low-severity at this epoch)#{1}":[16,18],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Note for cross-dimension reconciliation":[19,28],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Note for cross-dimension reconciliation#{1}":[20,26],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Note for cross-dimension reconciliation##2.2 Account state & permissions + 2.3 Market data + 2.4 Clock/calendar/assets (key=acct)":[27,28],"##2.1 Authentication & environment + 2.10 Paper→live cutover — audit#Note for cross-dimension reconciliation##2.2 Account state & permissions + 2.3 Market data + 2.4 Clock/calendar/assets (key=acct)#{1}":[28,28],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets":[29,71],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets#{1}":[31,54],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets###2.5 Order management (key=orders)":[55,69],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets###2.5 Order management (key=orders)#{1}":[56,69],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets###2.6 Streaming + 2.7 Rate limits & resilience + 2.8 Error handling & edge cases (key=resilience)":[70,71],"##2.2 Account state & permissions — 2.3 Market data — 2.4 Clock/calendar/assets###2.6 Streaming + 2.7 Rate limits & resilience + 2.8 Error handling & edge cases (key=resilience)#{1}":[71,71],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit":[72,103],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#{1}":[74,75],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Strengths":[76,81],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Strengths#{1}":[77,81],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Gaps (tied to evidence)":[82,89],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Gaps (tied to evidence)#{1}":[83,89],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Bottom line":[90,103],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Bottom line#{1}":[91,101],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Bottom line##2.9 Reconciliation & safety + the Operations Control Plane (kill switch, guards, audit) (key=safety)":[102,103],"##2.6 Streaming, 2.7 Rate-limits/Resilience, 2.8 Error handling — audit#Bottom line##2.9 Reconciliation & safety + the Operations Control Plane (kill switch, guards, audit) (key=safety)#{1}":[103,103],"##2.9 Reconciliation & safety + Operations Control Plane — audit\\n\\n**Framing.** el_nino is a single-instrument (GLD), paper-only, long-or-flat decision->execution pipeline whose only two Alpaca surfaces are default-OFF, fail-closed stdlib plugs. The Alpaca execution adapter is built-but-DORMANT (no LONG is emitted pre-calibration, ADR-012), so most reconciliation/safety gaps below are latent, not live failures. I classified each against the governing ADRs (ADR-013 ops control plane = accepted/active; ADR-014 operable adapter v1 = draft/not-started, hard-paused).\\n\\n### Strengths (verified)\\n- **Internal duplicate-order protection is real and layered.** `PortfolioState.has_execution(source_snapshot_id)` short-circuits a re-fill before `port.fill` (engine.py:91-92), and `RuntimeLedger.has_admit` does the same at admission (paper_runtime/predicates.py:31-35). Crash-consistency is deliberately reasoned: portfolio-first-then-ledger persistence (orchestration/runtime.py:9-12) makes a crash a safe redo, never a double-fill.\\n- **The GATE-001 guard battery is complete and correctly wired before execution.** All five hard-limit predicates (position size, daily loss cap, max trades, max positions, withdrawal-disabled) run as a short-circuit conjunction (predicates.py:66-72) via `run_guard` *before* `execute` on the live chain path (orchestration/engine.py:96-106), and a fill can only exist on an approved guard_result (models.py:303-305). `load_config_from_env` fails closed on any missing limit (guardrail_engine.py:43-47). The L3 cooldown guard (PRED-008) adds deterministic pacing.\\n- **The gated-live enablement matches ADR-013 to the letter.** The only route to a live Alpaca order — `run_chain_now_alpaca_paper` — enforces confirm modal + append-only audit + a *server-side* `adapter.client is None` precondition that refuses without placing an order (gated.py:84-90), and the client is non-None only when paper creds are present AND the URL passes parsed-hostname equality to `paper-api.alpaca.markets` (alpaca_adapter.py:45-56). The safe Tier-2 run is structurally incapable of reaching a live port (actions.py:67-89).\\n- **Console-action audit is solid:** every safe/gated action writes a redacted, append-only `AuditEntry` (audit.py:29-70), with a defense-in-depth secret-redaction pass over the full surface (proc.py:48-63), honouring ADR-013 sec.6/sec.7.\\n\\n### Gaps (each tied to evidence)\\n- **No startup reconcile, no broker reads.** There is zero `GET /v2/positions` or `GET /v2/account`; the live path loads only local JSON and places a blind market BUY. This is a *governed* gap — ADR-014 sec.6 plans the mandatory reconcile-then-act — but it is the single most important pre-live item.\\n- **No Alpaca `client_order_id`** in the POST body (alpaca_adapter.py:142-144), so there is no broker-side 422 dedup behind the internal once-ever guard. Governed (ADR-014 sec.6).\\n- **Two latent input-fidelity defects in the guard request:** `daily_pnl` is all-time realized P&L, and `trades_today` is the all-time fill count (runtime.py:91,99), both fed to guards named 'daily'. The `trades_today` proxy fails *safe* (over-blocks after 10 lifetime fills); the `daily_pnl` proxy is simply wrong across day boundaries. Documented as v0 approximations, but incorrect as written.\\n- **The GLD-vs-gold-spot price defect** is confirmed live in `run_chain` (engine.py:95) -> `execute` -> Alpaca `slippage_bps` (alpaca_adapter.py:116-121): a $/oz spot price (~4624) is used as the $/share GLD fill reference, producing meaningless slippage and wrong P&L units. Dormant today, but a real latent bug; ADR-014 sec.5 elevates its fix (B6) to blocking.\\n- **No cash-cap/account check, no QUEUED/PARTIAL/EXECUTION_UNCERTAIN state machine, no FLAT->SELL exit** — all governed by ADR-014 sec.6 and all absent (synchronous binary fill; non-LONG refused, alpaca_adapter.py:106-113).\\n- **No operator kill switch.** `halt` is only a read-only OperationalInput field on the dashboard and a guard input; no ops action can set it. This one is *ungoverned* (no ADR mandates a runtime halt), though mitigated by the one-shot gated model + default-OFF adapter + unregister-schedule.\\n\\n### Bottom line\\nThe internal safety spine (idempotency, GATE-001 guards, gated-live enablement, console audit) is genuinely strong and correctly composed. Every reconciliation/broker-realism gap is a *deliberate, ADR-014-governed* boundary on a dormant adapter — none is an ungoverned omission except the (low-severity) absence of an explicit kill switch. The two things I would not ship live without fixing are real code-as-written defects: the gold-spot price/slippage reference and the mislabeled cumulative 'daily' guard inputs.":[104,118],"##2.9 Reconciliation & safety + Operations Control Plane — audit\\n\\n**Framing.** el_nino is a single-instrument (GLD), paper-only, long-or-flat decision->execution pipeline whose only two Alpaca surfaces are default-OFF, fail-closed stdlib plugs. The Alpaca execution adapter is built-but-DORMANT (no LONG is emitted pre-calibration, ADR-012), so most reconciliation/safety gaps below are latent, not live failures. I classified each against the governing ADRs (ADR-013 ops control plane = accepted/active; ADR-014 operable adapter v1 = draft/not-started, hard-paused).\\n\\n### Strengths (verified)\\n- **Internal duplicate-order protection is real and layered.** `PortfolioState.has_execution(source_snapshot_id)` short-circuits a re-fill before `port.fill` (engine.py:91-92), and `RuntimeLedger.has_admit` does the same at admission (paper_runtime/predicates.py:31-35). Crash-consistency is deliberately reasoned: portfolio-first-then-ledger persistence (orchestration/runtime.py:9-12) makes a crash a safe redo, never a double-fill.\\n- **The GATE-001 guard battery is complete and correctly wired before execution.** All five hard-limit predicates (position size, daily loss cap, max trades, max positions, withdrawal-disabled) run as a short-circuit conjunction (predicates.py:66-72) via `run_guard` *before* `execute` on the live chain path (orchestration/engine.py:96-106), and a fill can only exist on an approved guard_result (models.py:303-305). `load_config_from_env` fails closed on any missing limit (guardrail_engine.py:43-47). The L3 cooldown guard (PRED-008) adds deterministic pacing.\\n- **The gated-live enablement matches ADR-013 to the letter.** The only route to a live Alpaca order — `run_chain_now_alpaca_paper` — enforces confirm modal + append-only audit + a *server-side* `adapter.client is None` precondition that refuses without placing an order (gated.py:84-90), and the client is non-None only when paper creds are present AND the URL passes parsed-hostname equality to `paper-api.alpaca.markets` (alpaca_adapter.py:45-56). The safe Tier-2 run is structurally incapable of reaching a live port (actions.py:67-89).\\n- **Console-action audit is solid:** every safe/gated action writes a redacted, append-only `AuditEntry` (audit.py:29-70), with a defense-in-depth secret-redaction pass over the full surface (proc.py:48-63), honouring ADR-013 sec.6/sec.7.\\n\\n### Gaps (each tied to evidence)\\n- **No startup reconcile, no broker reads.** There is zero `GET /v2/positions` or `GET /v2/account`; the live path loads only local JSON and places a blind market BUY. This is a *governed* gap — ADR-014 sec.6 plans the mandatory reconcile-then-act — but it is the single most important pre-live item.\\n- **No Alpaca `client_order_id`** in the POST body (alpaca_adapter.py:142-144), so there is no broker-side 422 dedup behind the internal once-ever guard. Governed (ADR-014 sec.6).\\n- **Two latent input-fidelity defects in the guard request:** `daily_pnl` is all-time realized P&L, and `trades_today` is the all-time fill count (runtime.py:91,99), both fed to guards named 'daily'. The `trades_today` proxy fails *safe* (over-blocks after 10 lifetime fills); the `daily_pnl` proxy is simply wrong across day boundaries. Documented as v0 approximations, but incorrect as written.\\n- **The GLD-vs-gold-spot price defect** is confirmed live in `run_chain` (engine.py:95) -> `execute` -> Alpaca `slippage_bps` (alpaca_adapter.py:116-121): a $/oz spot price (~4624) is used as the $/share GLD fill reference, producing meaningless slippage and wrong P&L units. Dormant today, but a real latent bug; ADR-014 sec.5 elevates its fix (B6) to blocking.\\n- **No cash-cap/account check, no QUEUED/PARTIAL/EXECUTION_UNCERTAIN state machine, no FLAT->SELL exit** — all governed by ADR-014 sec.6 and all absent (synchronous binary fill; non-LONG refused, alpaca_adapter.py:106-113).\\n- **No operator kill switch.** `halt` is only a read-only OperationalInput field on the dashboard and a guard input; no ops action can set it. This one is *ungoverned* (no ADR mandates a runtime halt), though mitigated by the one-shot gated model + default-OFF adapter + unregister-schedule.\\n\\n### Bottom line\\nThe internal safety spine (idempotency, GATE-001 guards, gated-live enablement, console audit) is genuinely strong and correctly composed. Every reconciliation/broker-realism gap is a *deliberate, ADR-014-governed* boundary on a dormant adapter — none is an ungoverned omission except the (low-severity) absence of an explicit kill switch. The two things I would not ship live without fixing are real code-as-written defects: the gold-spot price/slippage reference and the mislabeled cumulative 'daily' guard inputs.#{1}":[105,116],"##2.9 Reconciliation & safety + Operations Control Plane — audit\\n\\n**Framing.** el_nino is a single-instrument (GLD), paper-only, long-or-flat decision->execution pipeline whose only two Alpaca surfaces are default-OFF, fail-closed stdlib plugs. The Alpaca execution adapter is built-but-DORMANT (no LONG is emitted pre-calibration, ADR-012), so most reconciliation/safety gaps below are latent, not live failures. I classified each against the governing ADRs (ADR-013 ops control plane = accepted/active; ADR-014 operable adapter v1 = draft/not-started, hard-paused).\\n\\n### Strengths (verified)\\n- **Internal duplicate-order protection is real and layered.** `PortfolioState.has_execution(source_snapshot_id)` short-circuits a re-fill before `port.fill` (engine.py:91-92), and `RuntimeLedger.has_admit` does the same at admission (paper_runtime/predicates.py:31-35). Crash-consistency is deliberately reasoned: portfolio-first-then-ledger persistence (orchestration/runtime.py:9-12) makes a crash a safe redo, never a double-fill.\\n- **The GATE-001 guard battery is complete and correctly wired before execution.** All five hard-limit predicates (position size, daily loss cap, max trades, max positions, withdrawal-disabled) run as a short-circuit conjunction (predicates.py:66-72) via `run_guard` *before* `execute` on the live chain path (orchestration/engine.py:96-106), and a fill can only exist on an approved guard_result (models.py:303-305). `load_config_from_env` fails closed on any missing limit (guardrail_engine.py:43-47). The L3 cooldown guard (PRED-008) adds deterministic pacing.\\n- **The gated-live enablement matches ADR-013 to the letter.** The only route to a live Alpaca order — `run_chain_now_alpaca_paper` — enforces confirm modal + append-only audit + a *server-side* `adapter.client is None` precondition that refuses without placing an order (gated.py:84-90), and the client is non-None only when paper creds are present AND the URL passes parsed-hostname equality to `paper-api.alpaca.markets` (alpaca_adapter.py:45-56). The safe Tier-2 run is structurally incapable of reaching a live port (actions.py:67-89).\\n- **Console-action audit is solid:** every safe/gated action writes a redacted, append-only `AuditEntry` (audit.py:29-70), with a defense-in-depth secret-redaction pass over the full surface (proc.py:48-63), honouring ADR-013 sec.6/sec.7.\\n\\n### Gaps (each tied to evidence)\\n- **No startup reconcile, no broker reads.** There is zero `GET /v2/positions` or `GET /v2/account`; the live path loads only local JSON and places a blind market BUY. This is a *governed* gap — ADR-014 sec.6 plans the mandatory reconcile-then-act — but it is the single most important pre-live item.\\n- **No Alpaca `client_order_id`** in the POST body (alpaca_adapter.py:142-144), so there is no broker-side 422 dedup behind the internal once-ever guard. Governed (ADR-014 sec.6).\\n- **Two latent input-fidelity defects in the guard request:** `daily_pnl` is all-time realized P&L, and `trades_today` is the all-time fill count (runtime.py:91,99), both fed to guards named 'daily'. The `trades_today` proxy fails *safe* (over-blocks after 10 lifetime fills); the `daily_pnl` proxy is simply wrong across day boundaries. Documented as v0 approximations, but incorrect as written.\\n- **The GLD-vs-gold-spot price defect** is confirmed live in `run_chain` (engine.py:95) -> `execute` -> Alpaca `slippage_bps` (alpaca_adapter.py:116-121): a $/oz spot price (~4624) is used as the $/share GLD fill reference, producing meaningless slippage and wrong P&L units. Dormant today, but a real latent bug; ADR-014 sec.5 elevates its fix (B6) to blocking.\\n- **No cash-cap/account check, no QUEUED/PARTIAL/EXECUTION_UNCERTAIN state machine, no FLAT->SELL exit** — all governed by ADR-014 sec.6 and all absent (synchronous binary fill; non-LONG refused, alpaca_adapter.py:106-113).\\n- **No operator kill switch.** `halt` is only a read-only OperationalInput field on the dashboard and a guard input; no ops action can set it. This one is *ungoverned* (no ADR mandates a runtime halt), though mitigated by the one-shot gated model + default-OFF adapter + unregister-schedule.\\n\\n### Bottom line\\nThe internal safety spine (idempotency, GATE-001 guards, gated-live enablement, console audit) is genuinely strong and correctly composed. Every reconciliation/broker-realism gap is a *deliberate, ADR-014-governed* boundary on a dormant adapter — none is an ungoverned omission except the (low-severity) absence of an explicit kill switch. The two things I would not ship live without fixing are real code-as-written defects: the gold-spot price/slippage reference and the mislabeled cumulative 'daily' guard inputs.###PART 1 §1 Concept Overview + §2 Technical Feasibility (key=concept)":[117,118],"##2.9 Reconciliation & safety + Operations Control Plane — audit\\n\\n**Framing.** el_nino is a single-instrument (GLD), paper-only, long-or-flat decision->execution pipeline whose only two Alpaca surfaces are default-OFF, fail-closed stdlib plugs. The Alpaca execution adapter is built-but-DORMANT (no LONG is emitted pre-calibration, ADR-012), so most reconciliation/safety gaps below are latent, not live failures. I classified each against the governing ADRs (ADR-013 ops control plane = accepted/active; ADR-014 operable adapter v1 = draft/not-started, hard-paused).\\n\\n### Strengths (verified)\\n- **Internal duplicate-order protection is real and layered.** `PortfolioState.has_execution(source_snapshot_id)` short-circuits a re-fill before `port.fill` (engine.py:91-92), and `RuntimeLedger.has_admit` does the same at admission (paper_runtime/predicates.py:31-35). Crash-consistency is deliberately reasoned: portfolio-first-then-ledger persistence (orchestration/runtime.py:9-12) makes a crash a safe redo, never a double-fill.\\n- **The GATE-001 guard battery is complete and correctly wired before execution.** All five hard-limit predicates (position size, daily loss cap, max trades, max positions, withdrawal-disabled) run as a short-circuit conjunction (predicates.py:66-72) via `run_guard` *before* `execute` on the live chain path (orchestration/engine.py:96-106), and a fill can only exist on an approved guard_result (models.py:303-305). `load_config_from_env` fails closed on any missing limit (guardrail_engine.py:43-47). The L3 cooldown guard (PRED-008) adds deterministic pacing.\\n- **The gated-live enablement matches ADR-013 to the letter.** The only route to a live Alpaca order — `run_chain_now_alpaca_paper` — enforces confirm modal + append-only audit + a *server-side* `adapter.client is None` precondition that refuses without placing an order (gated.py:84-90), and the client is non-None only when paper creds are present AND the URL passes parsed-hostname equality to `paper-api.alpaca.markets` (alpaca_adapter.py:45-56). The safe Tier-2 run is structurally incapable of reaching a live port (actions.py:67-89).\\n- **Console-action audit is solid:** every safe/gated action writes a redacted, append-only `AuditEntry` (audit.py:29-70), with a defense-in-depth secret-redaction pass over the full surface (proc.py:48-63), honouring ADR-013 sec.6/sec.7.\\n\\n### Gaps (each tied to evidence)\\n- **No startup reconcile, no broker reads.** There is zero `GET /v2/positions` or `GET /v2/account`; the live path loads only local JSON and places a blind market BUY. This is a *governed* gap — ADR-014 sec.6 plans the mandatory reconcile-then-act — but it is the single most important pre-live item.\\n- **No Alpaca `client_order_id`** in the POST body (alpaca_adapter.py:142-144), so there is no broker-side 422 dedup behind the internal once-ever guard. Governed (ADR-014 sec.6).\\n- **Two latent input-fidelity defects in the guard request:** `daily_pnl` is all-time realized P&L, and `trades_today` is the all-time fill count (runtime.py:91,99), both fed to guards named 'daily'. The `trades_today` proxy fails *safe* (over-blocks after 10 lifetime fills); the `daily_pnl` proxy is simply wrong across day boundaries. Documented as v0 approximations, but incorrect as written.\\n- **The GLD-vs-gold-spot price defect** is confirmed live in `run_chain` (engine.py:95) -> `execute` -> Alpaca `slippage_bps` (alpaca_adapter.py:116-121): a $/oz spot price (~4624) is used as the $/share GLD fill reference, producing meaningless slippage and wrong P&L units. Dormant today, but a real latent bug; ADR-014 sec.5 elevates its fix (B6) to blocking.\\n- **No cash-cap/account check, no QUEUED/PARTIAL/EXECUTION_UNCERTAIN state machine, no FLAT->SELL exit** — all governed by ADR-014 sec.6 and all absent (synchronous binary fill; non-LONG refused, alpaca_adapter.py:106-113).\\n- **No operator kill switch.** `halt` is only a read-only OperationalInput field on the dashboard and a guard input; no ops action can set it. This one is *ungoverned* (no ADR mandates a runtime halt), though mitigated by the one-shot gated model + default-OFF adapter + unregister-schedule.\\n\\n### Bottom line\\nThe internal safety spine (idempotency, GATE-001 guards, gated-live enablement, console audit) is genuinely strong and correctly composed. Every reconciliation/broker-realism gap is a *deliberate, ADR-014-governed* boundary on a dormant adapter — none is an ungoverned omission except the (low-severity) absence of an explicit kill switch. The two things I would not ship live without fixing are real code-as-written defects: the gold-spot price/slippage reference and the mislabeled cumulative 'daily' guard inputs.###PART 1 §1 Concept Overview + §2 Technical Feasibility (key=concept)#{1}":[118,118],"##§1 Concept Overview + §2 Technical Feasibility — audit":[119,137],"##§1 Concept Overview + §2 Technical Feasibility — audit#{1}":[121,135],"##§1 Concept Overview + §2 Technical Feasibility — audit###PART 1 §3 Regulatory Compliance (key=regulatory)":[136,137],"##§1 Concept Overview + §2 Technical Feasibility — audit###PART 1 §3 Regulatory Compliance (key=regulatory)#{1}":[137,137],"##§3 Regulatory Compliance — audit":[138,159],"##§3 Regulatory Compliance — audit#{1}":[140,157],"##§3 Regulatory Compliance — audit###PART 1 §4 User Experience (key=ux)":[158,159],"##§3 Regulatory Compliance — audit###PART 1 §4 User Experience (key=ux)#{1}":[159,159],"##§4 User Experience — operator surface audit":[160,187],"##§4 User Experience — operator surface audit#{1}":[162,185],"##§4 User Experience — operator surface audit###PART 1 §5 Risk Management + §6 Audit Readiness (key=risk)":[186,187],"##§4 User Experience — operator surface audit###PART 1 §5 Risk Management + §6 Audit Readiness (key=risk)#{1}":[187,187],"##section 5 Risk Management + section 6 Audit Readiness - audit":[188,205],"##section 5 Risk Management + section 6 Audit Readiness - audit#{1}":[190,205]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:_audit_narr.txt#####2.1 Authentication & environment + 2.10 Paper→live cutover (key=auth)": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"14y1ug4","at":1782068239231},"key":"_audit_narr.txt#####2.1 Authentication & environment + 2.10 Paper→live cutover (key=auth)","lines":[3,4],"size":88,"outlinks":[],"class_name":"SmartBlock"},
