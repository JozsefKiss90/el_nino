      "filePath": "src/snapshot/snapshot_consumer/consumer.py",
      "summary": "Implements the Layer-3 side of the Snapshot API (INT-001) as a fail-closed gate: loads, validates, and yields a Layer-2 snapshot only when its quality gate passed and it is not forced or dry-run, returning None otherwise.",
      "tags": ["service", "validation", "api-handler", "serialization"],
      "complexity": "simple",
      "languageNotes": "Uses PEP 604 union return types (Snapshot | None) and a fail-closed pattern where absence and rejection both surface as None while structural faults raise."
    },
