      "id": "file:src/gold/paper_runtime/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "src/gold/paper_runtime/__init__.py",
      "summary": "Package barrel for the Paper-Trading Runtime (MOD-007) that re-exports the public API — evaluate, run_once/run_sequence, runtime models, config, and guard predicates — into a single import surface.",
      "tags": ["entry-point", "barrel", "exports", "paper-trading", "runtime"],
      "complexity": "simple",
      "languageNotes": "Python package barrel using explicit re-exports and an __all__ allowlist to define the public API."
    },
    {
      "id": "file:src/gold/paper_runtime/config.py",
      "type": "file",
      "name": "config.py",
      "filePath": "src/gold/paper_runtime/config.py",
      "summary": "Defines the immutable RuntimePolicyConfig dataclass and its deterministic fingerprint, controlling which L3 admission guards (operational, snapshot, cooldown) are required and the cooldown window.",
      "tags": ["config", "validation", "data-model", "runtime", "paper-trading"],
      "complexity": "moderate",
      "languageNotes": "Frozen dataclass with __post_init__ validation and a sha256 policy fingerprint for reproducible runtime-policy versioning."
    },
    {
      "id": "file:src/gold/paper_runtime/engine.py",
      "type": "file",
      "name": "engine.py",
      "filePath": "src/gold/paper_runtime/engine.py",
      "summary": "Pure runtime admission core: evaluate() runs the stateful and snapshot-derived L3 guards over a Gold DecisionPacket, produces a RuntimeDecisionRecord, and appends a deterministic entry to the runtime ledger without mutating inputs.",
      "tags": ["service", "runtime", "validation", "paper-trading", "decision-engine"],
      "complexity": "moderate",
      "languageNotes": "Side-effect-free evaluation function — all IO is delegated to runtime.py, keeping the core deterministically testable."
    },
    {
      "id": "file:src/gold/paper_runtime/models.py",
      "type": "file",
      "name": "models.py",
      "filePath": "src/gold/paper_runtime/models.py",
      "summary": "Core data contracts for the paper-trading runtime: Verdict enum, GuardOutcome, OperationalInput, the append-only RuntimeLedger with LedgerEntry, and the RuntimeDecisionRecord, plus deterministic hashing helpers for record IDs and snapshot-guard digests.",
      "tags": ["data-model", "serialization", "type-definition", "runtime", "paper-trading"],
      "complexity": "complex",
      "languageNotes": "Frozen dataclasses with strict from_dict/from_mapping contract validation and sha256-based state hashing for ledger integrity and replay safety."
    },
    {
      "id": "file:src/gold/paper_runtime/predicates.py",
      "type": "file",
      "name": "predicates.py",
      "filePath": "src/gold/paper_runtime/predicates.py",
      "summary": "Boolean guard predicates for runtime admission — duplicate_ok, operational_ok, data_ok, freshness_ok, and cooldown_ok — that decide whether a decision packet may be admitted given prior ledger state and operational input.",
      "tags": ["validation", "predicate", "runtime", "paper-trading", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/gold/paper_runtime/runtime.py",
      "type": "file",
      "name": "runtime.py",
      "filePath": "src/gold/paper_runtime/runtime.py",
      "summary": "IO boundary for the paper-trading runtime: loads/persists the append-only ledger and operational input from disk and drives run_once/run_sequence over the pure evaluate() core.",
      "tags": ["service", "serialization", "runtime", "paper-trading", "io"],
      "complexity": "moderate",
      "languageNotes": "Uses atomic write-then-os.replace for crash-safe ledger persistence."
    },
